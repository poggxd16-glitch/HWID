-- ลูป AFK ฟาร์มเงิน (หมวด 5)
task.spawn(function()
    while true do
        if afkFarm and catchRemote and sellRemote then
            for i = 1, maxItems do
                if not afkFarm then break end
                pcall(function() catchRemote:FireServer(unpack(catchArgs)) end)
                task.wait(0.05)
            end
            
            if afkFarm then
                local elapsed = 0
                while elapsed < waitMoneyTime and afkFarm do
                    task.wait(1)
                    elapsed = elapsed + 1
                end
                if afkFarm then
                    for i = 1, 5 do pcall(function() sellRemote:FireServer(unpack(sellArgs)) end) task.wait(0.1) end
                end
            end
            task.wait(0.5)
        else
            task.wait(0.5)
        end
    end
end)

