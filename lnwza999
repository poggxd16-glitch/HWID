local function getClosestPlayer()
    local targetPart, shortestDistance = nil, fovRadius
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local inset = GuiS:GetGuiInset()
    local screenCenter = Vector2.new(cam.ViewportSize.X / 2, (cam.ViewportSize.Y - inset.Y) / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChildOfClass("Humanoid") and p.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if root and (not aimbotTeamCheck or p.Team ~= LP.Team) then
                local pos, onScreen = cam:WorldToViewportPoint(root.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
                    if dist < shortestDistance then
                        if not aimbotWallCheck then
                            local params = RaycastParams.new() params.FilterType = RaycastFilterType.Exclude params.FilterDescendantsInstances = {LP.Character, p.Character}
                            if not workspace:Raycast(cam.CFrame.Position, root.Position - cam.CFrame.Position, params) then
                                shortestDistance = dist targetPart = root
                            end
                        else
                            shortestDistance = dist targetPart = root
                        end
                    end
                end
            end
        end
    end
    return targetPart
end

RunS.RenderStepped:Connect(function()
    if aimbotEnabled then
        local target = getClosestPlayer()
        if target and workspace.CurrentCamera then workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, target.Position) end
    end
end)

