-- ฟังก์ชันดึงรายชื่อผู้เล่นในเซิร์ฟ
local function getPlayerNames()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    if #list == 0 then
        table.insert(list, "ไม่พบผู้เล่นอื่นในเซิฟ")
    end
    return list
end

